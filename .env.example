# Cerebras (Kimi K3.1 Pro)
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
UNFOLD_MODEL=moonshotai-kimi-k3.1-pro-trial

# Auth + database (email sign-in + key storage). Optional: leave empty and set UNFOLD_DEV_NO_AUTH=1 for local demo mode.
NEXT_PUBLIC_UNFOLD_AUTH_URL=
NEXT_PUBLIC_UNFOLD_AUTH_ANON_KEY=
UNFOLD_AUTH_SERVICE_KEY=
UNFOLD_DEV_NO_AUTH=1

# 32-byte hex key used to encrypt user API keys at rest
UNFOLD_ENCRYPTION_KEY=

# OpenClaw gateway (profile "unfold", see agent-workspace/README)
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18890
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AGENT_ID=unfold

# Where uploads, analyses and plans are stored (absolute path)
UNFOLD_DATA_DIR=
