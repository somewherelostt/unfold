# Operator-only server configuration. Never use NEXT_PUBLIC_ for any publishing secret.
# Copy values to the server process's protected environment or local ignored .env.
# Do not paste credentials into issues, chats, database jobs, browser code, or recordings.
COMPOSIO_API_KEY=
# Optional overrides. Otherwise Connect creates/reuses minimal app-owned managed OAuth configs.
UNFOLD_PUBLISHING_INSTAGRAM_AUTH_CONFIG=
UNFOLD_PUBLISHING_PINTEREST_AUTH_CONFIG=
# Stable project/installation identifier used to namespace opaque provider user IDs.
UNFOLD_PUBLISHING_INSTANCE_ID=unfold
# The app's trusted origin for OAuth return; configure before connecting accounts.
UNFOLD_PUBLISHING_APP_ORIGIN=
# Preferred native routes; no app-hosted public media URL is required.
UNFOLD_PUBLISHING_INSTAGRAM_DELIVERY=staged_file
UNFOLD_PUBLISHING_PINTEREST_COVER=key_frame
# Public HTTPS origin serving the expiring exact-export delivery route.
# Only needed for an explicit public_url fallback. A localhost URL is insufficient.
# Do not expose the private storage tree.
UNFOLD_PUBLISHING_PUBLIC_ORIGIN=
# Default 30 minutes; maximum 21600 seconds only for documented async provider fetch.
UNFOLD_PUBLISHING_DELIVERY_TTL_SECONDS=1800
# Remain disabled until deletion hooks, real account eligibility and delivery are verified.
UNFOLD_PUBLISHING_ENABLED=0
UNFOLD_PUBLISHING_DELIVERY_ENABLED=0
# Existing persistent app storage is reused only through owner-scoped registered exports.
# UNFOLD_DATA_DIR=/persistent/unfold
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe
