# Copy to a private host configuration file. These are examples, not provisioned services.
UNFOLD_DATA_DIR=/var/lib/unfold
UNFOLD_JOBS_DB=/var/lib/unfold/jobs/jobs.sqlite
UNFOLD_JOBS_ARTIFACTS=/var/lib/unfold/jobs/artifacts
UNFOLD_JOB_BINDINGS=/opt/unfold/apps/web/src/server/job-bindings.ts
UNFOLD_INTERNAL_ORIGIN=http://127.0.0.1:3002

# Provision executables and models ahead of time. The worker never downloads a browser/model.
UNFOLD_BUN_BIN=/usr/local/bin/bun
FFMPEG_PATH=/usr/local/bin/ffmpeg
FFPROBE_PATH=/usr/local/bin/ffprobe
UNFOLD_STT_BIN=/usr/local/bin/whisper-cli
UNFOLD_STT_MODEL=/opt/unfold/services/media/models/ggml-base.en.bin
UNFOLD_BROWSER_EXECUTABLE=/opt/unfold/runtime/chrome-headless-shell/chrome-headless-shell

# OpenClaw runs Kimi on Cerebras. Supply the credential separately in the protected environment.
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18890
OPENCLAW_AGENT_ID=unfold
# OPENCLAW_GATEWAY_TOKEN is intentionally absent here.
UNFOLD_JOBS_REQUIRE_GATEWAY=true

UNFOLD_JOBS_MAX_QUEUED=32
UNFOLD_JOBS_MAX_PER_OWNER=4
UNFOLD_JOBS_MAX_RUNNING=2
UNFOLD_JOBS_RUNNING_PER_OWNER=1
UNFOLD_JOBS_RUNNING_PER_PROJECT=1
UNFOLD_JOBS_MAX_RENDERS=1
UNFOLD_JOBS_MAX_ANALYSIS=1
UNFOLD_JOBS_LEASE_MS=30000
UNFOLD_JOBS_RETRY_BASE_MS=2000
UNFOLD_JOBS_MAX_RUNTIME_MS=1200000
UNFOLD_JOBS_MIN_FREE_BYTES=1073741824
