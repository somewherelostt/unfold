# Copy to /etc/unfold/publishing.env, owned by root with mode 0600.
# Loaded by the web app and publishing worker, not by the media worker.
COMPOSIO_API_KEY=REPLACE_WITH_SERVER_KEY
UNFOLD_PUBLISHING_INSTANCE_ID=unfold-production
UNFOLD_PUBLISHING_APP_ORIGIN=https://unfold.maazx.dev
UNFOLD_PUBLISHING_INSTAGRAM_DELIVERY=staged_file
UNFOLD_PUBLISHING_PINTEREST_COVER=key_frame
UNFOLD_PUBLISHING_DELIVERY_ENABLED=0
# Keep paused during provisioning. Set to 1, restart web and start the publishing
# worker only for the production account/dispatch smoke test and normal operation.
UNFOLD_PUBLISHING_ENABLED=0
