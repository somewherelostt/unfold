# Copy to /etc/unfold/common.env. Replace the two Supabase placeholders.
# Read by systemd and Node's dotenv parser; use literal quoted values, no shell expansion.
NODE_ENV=production
UNFOLD_DEV_NO_AUTH=0
NEXT_PUBLIC_SITE_URL=https://unfold.maazx.dev
NEXT_PUBLIC_UNFOLD_AUTH_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_UNFOLD_AUTH_ANON_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_OR_ANON_KEY
NEXT_PUBLIC_UNFOLD_JOBS=1

# One checkout and one local persistent data directory for all three processes.
UNFOLD_REPO_ROOT=/opt/unfold
UNFOLD_DATA_DIR=/var/lib/unfold
UNFOLD_JOBS_DB=/var/lib/unfold/jobs/jobs.sqlite
UNFOLD_JOBS_ARTIFACTS=/var/lib/unfold/jobs/artifacts
UNFOLD_JOB_BINDINGS=/opt/unfold/apps/web/src/server/job-bindings.ts
UNFOLD_INTERNAL_ORIGIN=http://127.0.0.1:3000
TMPDIR=/var/cache/unfold

# Match the binaries installed on the Linux host. Never copy the Mac render browser.
UNFOLD_BUN_BIN=/usr/local/bin/bun
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
UNFOLD_DOWNLOADER_BIN=/usr/local/bin/yt-dlp
UNFOLD_STT_BIN=/opt/whisper.cpp/build/bin/whisper-cli
UNFOLD_STT_MODEL=/opt/whisper.cpp/models/ggml-base.en.bin
UNFOLD_STT_MULTILINGUAL_MODEL=/opt/whisper.cpp/models/ggml-base.bin
UNFOLD_BROWSER_EXECUTABLE=/opt/unfold/apps/web/node_modules/.remotion/chrome-headless-shell/linux64/chrome-headless-shell-linux64/chrome-headless-shell

# Media jobs do analysis/render/review, not AI planning. Production planning starts
# a separate loopback-only OpenClaw child with the authenticated user's saved key.
UNFOLD_JOBS_REQUIRE_GATEWAY=false
UNFOLD_JOBS_MAX_RUNNING=1
UNFOLD_JOBS_MAX_RENDERS=1
UNFOLD_JOBS_MAX_ANALYSIS=1
UNFOLD_JOBS_MAX_QUEUED=32
UNFOLD_JOBS_MAX_PER_OWNER=4
UNFOLD_JOBS_MIN_FREE_BYTES=5368709120
