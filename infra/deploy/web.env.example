# Copy to /etc/unfold/web.env, owned by root with mode 0600.
# Never use NEXT_PUBLIC_ for these values.
UNFOLD_AUTH_SERVICE_KEY=REPLACE_WITH_SUPABASE_SERVER_SECRET_OR_SERVICE_ROLE_KEY
UNFOLD_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
UNFOLD_OPENCLAW_BIN=/usr/local/bin/openclaw
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# No shared CEREBRAS_API_KEY is needed for the current per-user production flow.
