[Unit]
Description=Unfold durable media worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=unfold
Group=unfold
WorkingDirectory=/opt/unfold
EnvironmentFile=/etc/unfold/jobs.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
UMask=0077
ExecStartPre=/usr/bin/node services/jobs/scripts/recover.ts
ExecStartPre=/usr/bin/node services/jobs/scripts/health.ts
ExecStart=/usr/bin/node --import /opt/unfold/packages/video/node_modules/tsx/dist/loader.mjs services/jobs/scripts/worker.ts
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
TimeoutStopSec=30
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
