{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "./node_modules/@types",
      "../../apps/web/node_modules/@types"
    ],
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "../../apps/web/src/*"
      ]
    }
  },
  "include": [
    "src",
    "scripts",
    "test"
  ]
}
